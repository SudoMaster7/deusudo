# Copie para .env.local e preencha. O .env.local nao vai para o Git.
# Na Vercel, cadastre os mesmos nomes em Settings > Environment Variables.

# ── Assistente "S" do canto do site ────────────────────────────
# Cerebro do assistente. Sem ela ele responde uma frase de contingencia
# e manda a pessoa para o WhatsApp.
# Pegue em https://console.groq.com/keys
GROQ_API_KEY=

# ── Registro de interesse (Supabase) ───────────────────────────
# Sem estas o assistente funciona, mas nada e gravado e o painel fica vazio.
SUPABASE_URL=

# Chave SECRETA (sb_secret_... ou service_role). E a recomendada: ignora o RLS,
# entao grava E le. O painel /admin so lista os registros com esta chave.
# Fica em Project Settings > API Keys. Nunca chega ao navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Alternativa: chave PUBLICAVEL (sb_publishable_...). Ela GRAVA mas NAO LE,
# porque a tabela tem RLS sem politica de leitura. Com ela o painel nao
# mostra nada. Se usar esta, descomente o CAMINHO B em
# supabase/interesse-site.sql.
SUPABASE_KEY=

# ── Painel /admin ──────────────────────────────────────────────
# Senha de acesso ao painel de clientes em potencial. Minimo 8 caracteres.
# Sem ela ninguem entra no painel, nem voce.
ADMIN_PASSWORD=
